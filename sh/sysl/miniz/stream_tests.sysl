module sh.sysl.miniz
@tests

import sysl.buf.{Buf, buf}

// The `Decoder`, checked against streams other programs made.
//
// **The oracle is the formats and the tools that write them, never miniz.** `ZLIB` and `RAW` are
// Python's `zlib.compress(text, 9)` and `zlib.compressobj(9, DEFLATED, -15)`; `GZIP` is the system's
// `gzip -9 -c pack.txt`, so it carries FNAME and an MTIME; `GZIP_FLAGS` is the same deflate data under
// a header built by hand with FEXTRA, FNAME, FCOMMENT and FHCRC all set, which `gzip -t` and Python's
// `gzip.decompress` both accept. Each was checked to decompress to `text()` by the program that made
// it before its bytes were copied here.

private text() -> string =
    "Pack my box with five dozen liquor jugs. Pack my box with five dozen liquor jugs. " +
    "Pack my box with five dozen liquor jugs. Pack my box with five dozen liquor jugs. " +
    "Pack my box with five dozen liquor jugs. " +
    "Sphinx of black quartz, judge my vow; how vexingly quick daft zebras jump!\n"

private val ZLIB: [112]u8 = [
    0x78, 0xda, 0xd5, 0xcc, 0xc9, 0x11, 0x83, 0x30, 0x10, 0x44, 0xd1, 0xbb,
    0xa3, 0x68, 0xdf, 0x5d, 0x4e, 0xc0, 0x49, 0x50, 0xe5, 0x08, 0x24, 0x6b,
    0x1b, 0x23, 0x34, 0x20, 0xb4, 0xa1, 0xe8, 0x11, 0x61, 0x70, 0xee, 0xd7,
    0x7f, 0x12, 0xbf, 0x19, 0xcb, 0x01, 0xc9, 0x0d, 0x95, 0x92, 0x83, 0xa1,
    0xa2, 0xa1, 0xb8, 0xeb, 0x00, 0x4f, 0x5b, 0xe6, 0x88, 0x7f, 0xb6, 0xfb,
    0x1b, 0xd3, 0x0d, 0xe0, 0x77, 0x75, 0x14, 0x1a, 0xd8, 0x40, 0xfa, 0xeb,
    0xb3, 0x65, 0x11, 0x53, 0x7f, 0x8d, 0x55, 0x59, 0x7d, 0x15, 0x0a, 0xd7,
    0x0f, 0x1c, 0x57, 0x14, 0xdd, 0x28, 0x58, 0x7f, 0x0c, 0x42, 0x03, 0x2a,
    0x61, 0x12, 0xba, 0x96, 0x51, 0xec, 0x03, 0x2f, 0xeb, 0xf3, 0x71, 0x02,
    0x40, 0x18, 0x64, 0xad
]

